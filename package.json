{
  "name": "stockmok",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "packages/*",
    "functions"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:shared && npm run build:functions && npm run build:frontend",
    "build:frontend": "vite build",
    "build:shared": "npm run build --workspace @stockmok/shared",
    "build:functions": "npm run build --workspace @stockmok/functions",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check package.json package-lock.json firebase.json firestore.indexes.json tsconfig.json vite.config.ts vitest.config.ts playwright.config.ts eslint.config.js prettier.config.js index.html README.md \"src/**/*.{css,ts,tsx}\" \"packages/shared/**/*.{json,ts}\" \"functions/**/*.{json,ts}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"docs/implementation-evidence/*.md\" \".github/workflows/*.yml\"",
    "test:unit": "vitest run --exclude tests/bootstrap/**",
    "test:frontend": "vitest run src",
    "test:e2e": "playwright test",
    "hooks:install": "simple-git-hooks",
    "verify:indexes": "tsx scripts/verify-indexes.ts",
    "verify:architecture": "tsx scripts/verify-architecture.ts",
    "verify:functions": "tsx scripts/verify-functions.ts",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test:unit && npm run verify:indexes && npm run verify:architecture && npm run verify:functions && npm run build",
    "emu": "firebase emulators:start --project stockmok --import ./.emulator-data --export-on-exit ./.emulator-data",
    "emu:clean": "firebase emulators:start --project stockmok",
    "seed:bootstrap": "tsx scripts/bootstrap/seed.ts --target=emulator",
    "replay:bootstrap": "tsx scripts/bootstrap/replay.ts --target=emulator",
    "reset:emulator": "tsx scripts/bootstrap/reset.ts --target=emulator",
    "reseed:bootstrap": "npm run reset:emulator && npm run seed:bootstrap",
    "test:bootstrap:t0:inner": "tsx scripts/bootstrap/test-bootstrap.ts t0 --target=emulator",
    "test:bootstrap:replay:inner": "tsx scripts/bootstrap/test-bootstrap.ts replay --target=emulator",
    "test:bootstrap:t0": "firebase emulators:exec --project stockmok --only auth,firestore \"npm run test:bootstrap:t0:inner\"",
    "test:bootstrap:replay": "firebase emulators:exec --project stockmok --only auth,firestore \"npm run test:bootstrap:replay:inner\""
  },
  "simple-git-hooks": {
    "pre-commit": "npm run typecheck && npx lint-staged"
  },
  "lint-staged": {
    "*.{css,html,json,md,ts,tsx,yml}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.77.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.26.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "4.1.10"
  }
}
