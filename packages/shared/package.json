{
  "name": "@stockmok/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "default": "./dist/paths.js"
    },
    "./server/paths": {
      "node": {
        "types": "./dist/server/paths.d.ts",
        "default": "./dist/server/paths.js"
      }
    }
  },
  "browser": {
    "./dist/server/paths.js": false
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
